# obitickets settings and secrets. Copy this file to ".env" and fill in real values. NEVER commit the real .env.
#
# LIVE SERVER: create the file ONE FOLDER ABOVE public_html, for example
#   /home/u177785967/domains/obitickets.site/.env
# (outside public_html nothing can be downloaded with a URL). In hPanel > File Manager, go up from public_html and
# create a new file named .env there. Locally, put it in the project folder next to config/ and includes/.
#
# Format: KEY=value, one per line. Wrap a value in quotes if it has spaces. No comments after a value.
# The site only switches to this file once ALL of these are present: APP_ENV, APP_URL, APP_SECRET, DB_HOST, DB_NAME,
# DB_USER, DB_PASS (DB_PASS may be empty). Until then it keeps using config/config.php, so nothing breaks half-way.

APP_ENV=production
APP_URL=https://obitickets.site

# Long random value. Generate one with:  php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# ioTec Pay (mobile money collections) - id.iotec.io
IOTEC_CLIENT_ID=
IOTEC_CLIENT_SECRET=
IOTEC_WALLET_ID=

# ioTec Messaging (SMS) - messaging.iotec.io
IOTEC_MSG_CLIENT_ID=
IOTEC_MSG_API_KEY=

# Resend (email) - resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="obitickets <info@obitickets.site>"

# Google sign-in (leave both empty to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile bot check (leave both empty to switch it off)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Only if the site sits behind a proxy/CDN: the ONE header it sets with the visitor's IP (Cloudflare: HTTP_CF_CONNECTING_IP).
# Leave empty on the current Hostinger setup (the server sees the real IP).
TRUSTED_IP_HEADER=

# Optional extras (uncomment to use):
# SALES_NOTIFY_EMAIL=
# SUPPORT_WHATSAPP_NUMBER=
# Comma-separated IPs that the IP blocker must never block (for example your office):
# IPGUARD_ALLOW=
